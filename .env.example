# Environment Variables Template
NODE_ENV="development"

# PostgreSQL Database (matching docker-compose.yml)
DATABASE_URL="postgresql://centraxis:centraxis_password@localhost:5432/centraxis_db?schema=public"

# Redis Cache & PubSub (matching docker-compose.yml)
REDIS_URL="redis://localhost:6379"

# Auth.js / NextAuth
AUTH_SECRET="super-secret-auth-key-change-in-production-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# Bootstrap Admin Configuration (Used on cold-start/empty DB)
BOOTSTRAP_ADMIN_USERNAME="admin@centvis.com"
BOOTSTRAP_ADMIN_PASSWORD="AdminPassword123!"

# Microsoft Entra ID (Azure AD) SSO
AZURE_AD_CLIENT_ID="your-azure-ad-client-id"
AZURE_AD_CLIENT_SECRET="your-azure-ad-client-secret"
AZURE_AD_TENANT_ID="your-azure-ad-tenant-id"

# AI Story Agent (OpenAI / Anthropic)
OPENAI_API_KEY="sk-placeholder-api-key"
