generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------
// Enums
// ------------------------------------------------------

enum GlobalRole {
  SYSTEM_ADMIN
  USER
}

enum WorkflowScope {
  GLOBAL
  CLIENT
  PROJECT
}

enum StateCategory {
  START
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum ClientRole {
  CLIENT_ADMIN
  CLIENT_MEMBER
}

enum ProjectRole {
  PROJECT_LEAD
  MEMBER
  VIEWER
}

enum TeamRole {
  ORG_ADMIN
  SCRUM_MASTER
  DEVELOPER
  VIEWER
}

enum SprintStatus {
  PLANNED
  ACTIVE
  COMPLETED
}

enum WorkItemType {
  EPIC
  FEATURE
  STORY
  TASK
  BUG
}

enum WorkItemStatus {
  BACKLOG
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum WorkItemPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ------------------------------------------------------
// IAM & Tenancy Models (compatible with Auth.js v5)
// ------------------------------------------------------

model Organization {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  users       User[]
  teams       Team[]
  projects    Project[]
  clients     Client[]
  invitations Invitation[]
}

model Client {
  id               String         @id @default(cuid())
  name             String
  slug             String         // e.g. "acme-corp"
  logo             String?
  contactEmail     String?
  orgId            String
  organization     Organization   @relation(fields: [orgId], references: [id], onDelete: Cascade)
  projects         Project[]
  members          ClientMember[]
  workflowId       String?
  workflow         Workflow?      @relation("ClientWorkflow", fields: [workflowId], references: [id], onDelete: SetNull)
  definedWorkflows Workflow[]     @relation("ClientDefinedWorkflows")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([orgId, slug])
  @@index([orgId])
  @@index([workflowId])
}

model ClientMember {
  id        String     @id @default(cuid())
  userId    String
  clientId  String
  role      ClientRole @default(CLIENT_MEMBER)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([userId, clientId])
  @@index([userId])
  @@index([clientId])
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  password      String?
  globalRole    GlobalRole      @default(USER)
  role          TeamRole        @default(DEVELOPER)
  isTemporary   Boolean         @default(false)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  organizationId String?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  accounts           Account[]
  sessions           Session[]
  memberships        TeamMembership[]
  clientMemberships  ClientMember[]
  projectMemberships ProjectMember[]
  sentInvitations    Invitation[]    @relation("SentInvitations")

  assignedWorkItems WorkItem[]  @relation("AssignedWorkItems")
  reportedWorkItems WorkItem[]  @relation("ReportedWorkItems")
  aiStoryLogs       AiStoryLog[]
  comments          Comment[]
  mentions          Mention[]
  notifications     Notification[]
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  role           TeamRole     @default(DEVELOPER)
  token          String       @unique @default(cuid())
  status         String       @default("PENDING") // PENDING, ACCEPTED, REVOKED
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  invitedById    String?
  invitedBy      User?        @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: SetNull)

  teamIds        String[]     // IDs of initial squads to join

  @@index([organizationId])
  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------
// Team & Project Matrix
// ------------------------------------------------------

model Team {
  id             String           @id @default(cuid())
  name           String
  description    String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  memberships    TeamMembership[]
  projectTeams   ProjectTeam[]
  sprints        Sprint[]

  @@index([organizationId])
}

model TeamMembership {
  id        String   @id @default(cuid())
  role      TeamRole @default(DEVELOPER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId])
  @@index([teamId])
  @@index([userId])
}

model Project {
  id                        String        @id @default(cuid())
  key                       String        @unique // e.g. "CTX", "MOB"
  name                      String
  description               String?
  defaultSprintDurationDays Int           @default(14)
  createdAt                 DateTime      @default(now())
  updatedAt                 DateTime      @updatedAt

  organizationId            String
  organization              Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  clientId                  String?
  client                    Client?       @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectTeams              ProjectTeam[]
  sprints                   Sprint[]
  workItems                 WorkItem[]
  members                   ProjectMember[]

  workflowId                String?
  workflow                  Workflow?     @relation("ProjectWorkflow", fields: [workflowId], references: [id], onDelete: SetNull)
  definedWorkflows          Workflow[]    @relation("ProjectDefinedWorkflows")

  @@index([organizationId])
  @@index([clientId])
  @@index([workflowId])
}

model ProjectMember {
  id        String      @id @default(cuid())
  userId    String
  projectId String
  role      ProjectRole @default(MEMBER)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
}

model ProjectTeam {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([projectId, teamId])
  @@index([projectId])
  @@index([teamId])
}

// ------------------------------------------------------
// Sprint Planning
// ------------------------------------------------------

model Sprint {
  id        String       @id @default(cuid())
  name      String
  goal      String?      @db.Text
  startDate DateTime?
  endDate   DateTime?
  status    SprintStatus @default(PLANNED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  teamId    String?
  team      Team?        @relation(fields: [teamId], references: [id], onDelete: SetNull)

  projectId String
  project   Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  workItems WorkItem[]

  @@index([projectId])
  @@index([teamId])
}

// ------------------------------------------------------
// Hierarchical Backlog & Work Items
// ------------------------------------------------------

model WorkItem {
  id                 String           @id @default(cuid())
  key                String           // e.g. "CTX-1", "CTX-2"
  title              String
  description        String?          @db.Text
  acceptanceCriteria String?          @db.Text
  type               WorkItemType     @default(STORY)
  status             WorkItemStatus   @default(BACKLOG)
  stateSlug          String?          @default("todo")
  priority           WorkItemPriority @default(MEDIUM)
  storyPoints        Float?
  rankOrder          Float            @default(0)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  // Self-referencing parent/child hierarchy (Epic -> Feature -> Story -> Task/Bug)
  parentId           String?
  parent             WorkItem?        @relation("WorkItemHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           WorkItem[]       @relation("WorkItemHierarchy")

  projectId          String
  project            Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId           String?
  sprint             Sprint?          @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  assigneeId         String?
  assignee           User?            @relation("AssignedWorkItems", fields: [assigneeId], references: [id], onDelete: SetNull)

  reporterId         String?
  reporter           User?            @relation("ReportedWorkItems", fields: [reporterId], references: [id], onDelete: SetNull)

  aiStoryLogs        AiStoryLog[]
  comments           Comment[]

  @@unique([projectId, key])
  @@index([projectId, status])
  @@index([sprintId, status])
  @@index([parentId])
  @@index([assigneeId])
  @@index([rankOrder])
}

// ------------------------------------------------------
// AI Story Agent Auditing
// ------------------------------------------------------

model AiStoryLog {
  id               String    @id @default(cuid())
  rawPrompt        String    @db.Text
  generatedPayload Json
  modelUsed        String
  createdAt        DateTime  @default(now())

  acceptedByUserId String?
  acceptedByUser   User?     @relation(fields: [acceptedByUserId], references: [id], onDelete: SetNull)

  workItemId       String?
  workItem         WorkItem? @relation(fields: [workItemId], references: [id], onDelete: SetNull)

  @@index([acceptedByUserId])
  @@index([workItemId])
}

// ------------------------------------------------------
// Comments, Mentions & In-App Notifications
// ------------------------------------------------------

model Comment {
  id         String     @id @default(cuid())
  body       String     @db.Text
  workItemId String
  workItem   WorkItem   @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  authorId   String
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  mentions   Mention[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([workItemId])
  @@index([authorId])
}

model Mention {
  id              String        @id @default(cuid())
  commentId       String?
  comment         Comment?      @relation(fields: [commentId], references: [id], onDelete: Cascade)
  mentionedUserId String
  mentionedUser   User          @relation(fields: [mentionedUserId], references: [id], onDelete: Cascade)
  notification    Notification?
  createdAt       DateTime      @default(now())

  @@index([mentionedUserId])
  @@index([commentId])
}

enum NotificationType {
  MENTION
  ASSIGNED
  STATUS_CHANGED
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       NotificationType @default(MENTION)
  title      String
  message    String
  link       String           // e.g. "/[clientSlug]/[projectKey]/board?item=CTX-101"
  isRead     Boolean          @default(false)
  mentionId  String?          @unique
  mention    Mention?         @relation(fields: [mentionId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@index([userId, isRead])
}

// ------------------------------------------------------
// Customizable & Publishable Workflow Engine
// ------------------------------------------------------

model Workflow {
  id          String        @id @default(cuid())
  name        String
  description String?       @db.Text
  scope       WorkflowScope @default(GLOBAL)
  isPublished Boolean       @default(false)
  version     Int           @default(1)

  // Scope associations (null for GLOBAL)
  clientId    String?
  client      Client?       @relation("ClientDefinedWorkflows", fields: [clientId], references: [id], onDelete: Cascade)
  projectId   String?
  project     Project?      @relation("ProjectDefinedWorkflows", fields: [projectId], references: [id], onDelete: Cascade)

  // Associated entities actively using this workflow
  activeProjects Project[]  @relation("ProjectWorkflow")
  activeClients  Client[]   @relation("ClientWorkflow")

  states      WorkflowState[]
  transitions WorkflowTransition[]

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([scope, isPublished])
  @@index([clientId])
  @@index([projectId])
}

model WorkflowState {
  id          String         @id @default(cuid())
  name        String         // e.g. "TO DO", "IN DEVELOPMENT", "READY FOR QA", "IN QA", "REOPENED", "RESOLVED", "DONE"
  slug        String         // e.g. "in_development"
  category    StateCategory  @default(IN_PROGRESS)
  color       String?        // Tailwind/Hex token (e.g. blue for dev, amber for QA, green for done)
  orderIndex  Int            @default(0)
  
  workflowId  String
  workflow    Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  // Transitions connected to this state
  fromTransitions WorkflowTransition[] @relation("FromState")
  toTransitions   WorkflowTransition[] @relation("ToState")

  @@unique([workflowId, slug])
  @@index([workflowId, orderIndex])
}

model WorkflowTransition {
  id          String         @id @default(cuid())
  name        String         // Label: e.g. "Start Development", "Submit to QA", "QA Failed", "Close Issue"
  
  workflowId  String
  workflow    Workflow       @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  fromStateId String?        // null represents "Any" state transition
  fromState   WorkflowState? @relation("FromState", fields: [fromStateId], references: [id], onDelete: Cascade)

  toStateId   String
  toState     WorkflowState  @relation("ToState", fields: [toStateId], references: [id], onDelete: Cascade)

  requiredRole ProjectRole?  // Optional guard: e.g., only QA / Lead can trigger "QA Passed"
  createdAt   DateTime       @default(now())

  @@index([workflowId, fromStateId])
  @@index([workflowId, toStateId])
}

